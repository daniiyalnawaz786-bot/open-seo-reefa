# Copy to .env.local and fill in what you need. Everything is optional.

# Google PageSpeed Insights API key (free). Turns on Core Web Vitals and real phone and desktop
# screenshots once "Core Web Vitals" is switched on in Settings.
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Ask for a password (user "admin") on history, the crawler, leads and settings.
# Leave empty on your own computer; set it on any public server.
ADMIN_PASSWORD=

# Where reports, crawls, leads and settings are stored as JSON files.
OPENSEO_DATA_DIR=./data

# Audits and crawls one visitor may start per hour, and as many share previews. 0 turns the
# limit off.
OPENSEO_RATE_LIMIT=60

# Audits and crawls that run at the same time; the rest wait their turn.
OPENSEO_MAX_CONCURRENT=4

# Allow auditing localhost and private networks (10.x, 192.168.x …). Keep false on public servers.
OPENSEO_ALLOW_PRIVATE=false

# The User-Agent sent to audited sites.
# OPENSEO_USER_AGENT=

# The mail server monitors send alert emails through, and who they come from. Who gets them is
# set in Settings, under Alerts. Encode an @ in the user name as %40.
# SMTP_URL=smtps://you%40example.com:password@smtp.example.com:465
# SMTP_FROM=OpenSEO <seo@example.com>

# Set to false to stop this copy of OpenSEO running monitors, like a second copy that shares the
# same data folder.
# OPENSEO_SCHEDULER=true

# Optional: require a Bearer token for POST /api/audit when configured
OPENSEO_API_TOKEN=
